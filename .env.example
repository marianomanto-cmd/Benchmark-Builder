# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Project Settings → API → service_role key. SOLO server:
# route del PDF (firma URLs de Storage) y cron. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# URL pública del deploy. Se usa como redirect del magic link.
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dominio permitido para el login del consultorio.
# Vacío = sin restricción de dominio en el cliente
# (la restricción dura se hace igual en Supabase Auth).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=smilelab.com.ar

# ─────────────────────────────────────────────────────────────
# Cron (Vercel)
# ─────────────────────────────────────────────────────────────
# Secreto que valida /api/cron/pendientes. Vercel manda
# Authorization: Bearer $CRON_SECRET en los cron jobs.
CRON_SECRET=cambiar-por-un-secreto-largo

# ─────────────────────────────────────────────────────────────
# Datos del consultorio (encabezado y pie del PDF)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONSULTORIO_NOMBRE=Smile Lab
NEXT_PUBLIC_CONSULTORIO_DIRECCION=Av. Colón 1234, Córdoba
NEXT_PUBLIC_CONSULTORIO_TELEFONO=+54 351 000-0000
NEXT_PUBLIC_CONSULTORIO_EMAIL=hola@smilelab.com.ar
