# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Project Settings → API → service_role key. SOLO server:
# route del PDF (firma URLs de Storage) y cron. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# URL pública del deploy. Se usa como redirect del magic link.
# En Vercel, cargarla SÓLO en Production: si está en Preview, los
# enlaces de las previews redirigen a producción. Sin ella se usa el
# origin del request, que es lo correcto para cada preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Cron (Vercel)
# ─────────────────────────────────────────────────────────────
# Secreto que valida /api/cron/pendientes. Vercel manda
# Authorization: Bearer $CRON_SECRET en los cron jobs.
# Generar con: openssl rand -hex 32
CRON_SECRET=cambiar-por-un-secreto-largo

# Los datos del consultorio que salen en el PDF NO son variables de
# entorno: son constantes en lib/pdf/consultorio.ts, porque el
# consultorio es uno solo y no cambian entre entornos.
